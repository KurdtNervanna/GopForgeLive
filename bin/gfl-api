#!/usr/bin/env bash
# gfl-api — JSON API over the GopForge-Live engine, used by the GUI backend.
#
#   gfl-api <command> [args…]
#
# Contract:
#   * stdout  — exactly ONE JSON document (the result), always.
#   * stderr  — human-readable progress (streamed live into the GUI console).
#   * exit    — 0 ok · 1 failed · 2 refused by a safety gate · 64 bad usage.
#
# Every command that writes to hardware re-checks its own safety gates here, so
# the GUI can never talk it into an unsafe write:
#   - machine gating (cMP → BootROM only, supported iMac → GPU only) unless the
#     operator enabled Expert mode (GFL_EXPERT=1),
#   - a verified backup taken on this USB before any GPU flash,
#   - hard blocks for ROM methods the model forbids (EG2 on iMac10,1 A1312…),
#   - 4 MiB / fingerprint / EnableGop checks before a BootROM write,
#   - patched BootROMs may differ from the backup only inside the DXE volume, and
#     the chip is re-read before writing to prove it still matches that backup,
#   - an exact typed confirmation phrase (GFL_CONFIRM).
#
# SPDX-License-Identifier: MIT
set -Eeuo pipefail

GFL_BIN="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export GFL_TTY=/dev/stderr GFL_NO_COLOR=1
# shellcheck source=lib/bootstrap.sh
. "$GFL_BIN/lib/bootstrap.sh"

GFL_EXPERT="${GFL_EXPERT:-0}"
GFL_MOCK="${GFL_MOCK:-0}"

# Byte signatures (lower-case hex, little-endian GUIDs) — same as GopForge.
ANCHOR_HEX="9f59e7ba6b3cb743bdf09ce07aa91aa6"   # BAE7599F-… cMP 4,1/5,1 DXE anchor
EG_HEX="b158ba3fc0f8bc41acd8253043a3a17f"       # 3FBA58B1-… EnableGop FFS
FOUR_MIB=4194304

# --- output helpers ------------------------------------------------------------
emit() { jq -cn "$@"; }
fail() { # code message [exit]
  emit --arg c "$1" --arg m "$2" '{ok:false, code:$c, error:$m}'
  _log API "fail $1: $2"
  exit "${3:-1}"
}
refuse() { fail "$1" "$2" 2; }
need()   { [ "$#" -ge 2 ] && [ -n "$2" ] || fail usage "missing argument: $1" 64; }
truthy() { [ "${1:-0}" = 1 ]; }

bytes_count() { # file hex -> occurrences
  perl -e 'my($f,$h)=@ARGV; my $g=pack("H*",$h); local $/;
           open(my $fh,"<:raw",$f) or do { print 0; exit }; my $d=<$fh>;
           my ($n,$p)=(0,0); while(($p=index($d,$g,$p))>=0){$n++;$p++} print $n' "$1" "$2"
}
has_fvh() { perl -0777 -ne 'exit(/_FVH/ ? 0 : 1)' "$1" 2>/dev/null; }

file_json() { # path -> {path,name,size,sha256}
  local p="$1"
  emit --arg p "$p" --arg n "$(basename "$p")" --argjson s "$(file_size "$p")" \
       --arg h "$(sha256_of "$p")" '{path:$p, name:$n, size:$s, sha256:$h}'
}

# A path the GUI hands back must be a real file inside our working dir.
in_workdir() { # path
  local p r w
  p="$1"; [ -f "$p" ] || return 1
  r="$(readlink -f -- "$p")"; w="$(readlink -f -- "$GFL_WORKDIR")"
  case "$r" in "$w"/*) return 0;; *) return 1;; esac
}

allow_gpu()     { [ "${GFL_ALLOW_GPU:-0}" = 1 ]     || truthy "$GFL_EXPERT"; }
# Reading a card's firmware is harmless, so Mac Pros may back up (not flash) too.
allow_gpu_backup() { allow_gpu || [ "${GFL_MACHINE_CLASS:-}" = cmp-bootrom ]; }
allow_bootrom() { [ "${GFL_ALLOW_BOOTROM:-0}" = 1 ] || truthy "$GFL_EXPERT"; }

setup() {
  truthy "$GFL_MOCK" || require_root
  locate_flash_tools >/dev/null 2>&1 || true
  [ -n "${GFL_TOOLBIN:-}" ] && [ -d "$GFL_TOOLBIN" ] && PATH="$GFL_TOOLBIN:$PATH"
  machine_profile
}

# Can we actually run the EnableGop injector on this OS?
injector_state() {
  if truthy "$GFL_MOCK"; then echo mock; return; fi
  # The Linux build (vendor/dxeinject-linux) is what patches on the USB.
  if linux_dxeinject >/dev/null; then echo ok; return; fi
  [ -f "$GFL_DXEINJECT_DIR/dxeinject.bin" ] && { echo broken; return; }
  local d="$GFL_GOPFORGE_TOOLS/DXEInject" magic
  [ -f "$d" ] || { echo missing; return; }
  magic="$(od -An -tx1 -N4 "$d" 2>/dev/null | tr -d ' \n')"
  case "$magic" in
    7f454c46)                     echo ok ;;
    cffaedfe|cefaedfe|cafebabe)   echo macos-only ;;
    *)                            echo unknown ;;
  esac
}

# --- commands ------------------------------------------------------------------
cmd_status() {
  local ffs_std=false ffs_dir=false
  [ -f "$GFL_GOPFORGE_TOOLS/EnableGop.ffs" ] && ffs_std=true
  [ -f "$GFL_GOPFORGE_TOOLS/EnableGopDirect.ffs" ] && ffs_dir=true
  emit \
    --arg ver "$GFL_VERSION" \
    --arg model "${GFL_MAC_MODEL:-}" --arg label "$GFL_MACHINE_LABEL" \
    --arg class "$GFL_MACHINE_CLASS" --arg note "$GFL_MACHINE_NOTE" \
    --arg ab "$GFL_ALLOW_BOOTROM" --arg ag "$GFL_ALLOW_GPU" \
    --arg expert "$GFL_EXPERT" --arg mock "$GFL_MOCK" \
    --arg fr "$(command -v flashrom 2>/dev/null || true)" \
    --arg amd "${GFL_AMDVBFLASH:-}" --arg nv "${GFL_NVFLASH:-}" \
    --arg gf "$( [ -f "$GFL_GOPFORGE" ] && echo "$GFL_GOPFORGE" || true)" \
    --arg inj "$(injector_state)" --argjson fstd "$ffs_std" --argjson fdir "$ffs_dir" \
    --arg jqv "$(jq --version 2>/dev/null || true)" \
    --arg wd "$GFL_WORKDIR" --arg med "${GFL_MEDIUM:-}" --arg log "$GFL_LOG" \
    --arg roms "$(find "$GFL_ROMS" -type f -iname '*.rom' 2>/dev/null | wc -l | tr -d ' ')" \
    --arg cmd "$(cat /proc/cmdline 2>/dev/null || true)" \
    '{ok:true, version:$ver, mock:($mock=="1"), expert:($expert=="1"),
      machine:{model:$model, label:$label, class:$class, note:$note,
               allow_bootrom:($ab=="1"), allow_gpu:($ag=="1")},
      tools:{flashrom:$fr, amdvbflash:$amd, nvflash:$nv, gopforge:$gf, jq:$jqv,
             injector:$inj, enablegop_ffs:{standard:$fstd, direct:$fdir}},
      storage:{workdir:$wd, medium:$med, on_usb:($med!=""), log:$log},
      library:{roms:($roms|tonumber)}, cmdline:$cmd}'
}

# Full hardware report: summary JSON + the text report, which is also saved to
# gopforge-live/reports/ on the USB (it includes serial numbers and MAC addresses).
cmd_hardware() {
  local f j
  f="$GFL_WORKDIR/reports/hardware-$(date +%Y%m%d-%H%M%S).txt"
  if j="$(python3 "$GFL_LIB/hwreport.py" save "$f" 2>/dev/null)" && [ -n "$j" ]; then
    sync 2>/dev/null || true
    _log API "hardware report saved: $f"
    printf '%s\n' "$j" | jq -c '{ok:true} + .'
  else
    local t; t="$(detect_report 2>&1 || true)"
    emit --arg t "$t" '{ok:true, text:$t, saved:"", partial:true}'
  fi
}

cmd_hw_summary() { # quick facts for the overview (nothing saved)
  local j; j="$(python3 "$GFL_LIB/hwreport.py" summary 2>/dev/null)" || j=""
  [ -n "$j" ] || fail hw_failed "hardware summary unavailable"
  printf '%s\n' "$j" | jq -c '{ok:true, system, bootrom, cpus, cpu_totals, memory:(.memory|del(.modules[]?.serial))}'
}

cmd_gpus() {
  detect_gpus >/dev/null 2>&1 || true
  local i rows="[]"
  for i in "${!GFL_GPU_BDF[@]}"; do
    rows="$(jq -c --argjson i "$i" --arg bdf "${GFL_GPU_BDF[$i]}" --arg v "${GFL_GPU_VENDOR[$i]}" \
      --arg vl "$(gpu_vendor_label "${GFL_GPU_VENDOR[$i]}")" --arg d "${GFL_GPU_DEVICE[$i]}" \
      --arg s "${GFL_GPU_SUBSYS[$i]}" --arg n "${GFL_GPU_NAME[$i]}" \
      '. + [{index:$i, bdf:$bdf, vendor:$v, vendor_label:$vl, device:$d, subsys:$s, name:$n,
             flasher:(if $v=="1002" then "amd" elif $v=="10de" then "nvidia" else "" end)}]' <<<"$rows")"
  done
  emit --argjson g "$rows" '{ok:true, gpus:$g}'
}

cmd_model() { # [model_key] -> profile + ambiguity/variants
  lib_ok || fail no_matrix "jq or the ROM matrix is missing"
  local vars="[]" k n
  if model_ambiguous; then
    while IFS=$'\t' read -r k n; do
      [ -n "$k" ] && vars="$(jq -c --arg k "$k" --arg n "$n" '. + [{key:$k, note:$n}]' <<<"$vars")"
    done < <(model_variant_items)
  fi
  GFL_MODEL_KEY="${1:-${GFL_MAC_MODEL:-}}"; model_profile
  emit --arg raw "${GFL_MAC_MODEL:-}" --arg key "$GFL_MODEL_KEY" --arg p "$GFL_PANEL" \
       --arg d "$GFL_DRIVER" --arg f "$GFL_FORBID" --arg n "$GFL_MODEL_NOTE" --argjson v "$vars" \
       '{ok:true, raw:$raw, key:$key, panel:$p, driver:$d,
         forbid:($f|split(",")|map(select(.!=""))), note:$n,
         ambiguous:(($v|length)>0), variants:$v}'
}

# Ranked ROM candidates for a detected GPU.
cmd_plan() { # gpu_index [model_key]
  need gpu_index "${1:-}"
  lib_ok || fail no_matrix "jq or the ROM matrix is missing"
  detect_gpus >/dev/null 2>&1 || true
  local gi="$1"
  [ -n "${GFL_GPU_BDF[$gi]:-}" ] || fail bad_gpu "no GPU with index $gi"
  GFL_MODEL_KEY="${2:-${GFL_MAC_MODEL:-}}"; model_profile
  local dev="${GFL_GPU_DEVICE[$gi]}" name="${GFL_GPU_NAME[$gi]}" cards="[]" card
  while IFS= read -r card; do
    [ -n "$card" ] || continue
    local roms="[]" file method panel mem vram note abs marker level text rank forb
    while IFS=$'\x1f' read -r file method panel mem vram note; do   # 0x1f: see library.sh
      abs="$(resolve_rom "$file" || true)"
      marker="$(_rom_marker "$method" "$panel")"
      case "$marker" in ✓*) level=ok;; ⚠*) level=warn;; ✗*) level=bad;; *) level=info;; esac
      text="${marker#* }"
      forb=false; case ",$GFL_FORBID," in *",$method,"*) forb=true;; esac
      rank=5; case "$method" in gop) rank=0;; eg2|eg91) rank=1;; eg) rank=2;; uga) rank=3;; esac
      case "$level" in bad) rank=$((rank+10));; warn) rank=$((rank+5));; esac
      [ -n "$abs" ] || rank=$((rank+50))
      roms="$(jq -c --arg f "$file" --arg m "$method" --arg p "$panel" --arg me "$mem" \
        --arg v "$vram" --arg no "$note" --arg a "$abs" --arg l "$level" --arg t "$text" \
        --argjson r "$rank" --argjson fb "$forb" \
        '. + [{file:$f, method:$m, panel:$p, mem:$me, vram:$v, note:$no, path:$a,
               present:($a!=""), marker:{level:$l, text:$t}, forbidden:$fb, rank:$r}]' <<<"$roms")"
    done < <(jq -r '.roms[] | [.file, (.method//""), (.panel//""), (.mem//""), (.vram//""), (.note//"")] | join("\u001f")' <<<"$card")
    cards="$(jq -c --argjson c "$card" --argjson r "$roms" --arg bl "$(card_backlight_addon "$card")" \
      '. + [{name:$c.name, family:($c.family//""), notes:($c.notes//""), lvds:($c.lvds//null),
             hot:($c.hot//false), memory_variants:($c.memory_variants//false),
             backlight_addon:$bl, roms:($r|sort_by(.rank, .file))}]' <<<"$cards")"
  done < <(matrix_find_cards "$dev" "$name")
  local bl_note="" bl_url=""
  IFS=$'\t' read -r bl_note bl_url < <(backlight_addon_info) || true
  emit --argjson gi "$gi" --arg dev "$dev" --arg name "$name" --arg key "$GFL_MODEL_KEY" \
       --arg p "$GFL_PANEL" --arg d "$GFL_DRIVER" --arg f "$GFL_FORBID" --arg n "$GFL_MODEL_NOTE" \
       --arg inch "$GFL_MODEL_INCH" --arg bn "$bl_note" --arg bu "$bl_url" \
       --argjson c "$cards" \
       '{ok:true, gpu:{index:$gi, device:$dev, name:$name},
         model:{key:$key, panel:$p, driver:$d, forbid:($f|split(",")|map(select(.!=""))), note:$n,
                inch:(if $inch == "" then null else ($inch|tonumber) end)},
         backlight_addon:{note:$bn, url:$bu}, cards:$c}'
}

cmd_library() {
  # One find + one jq pass (a jq call per ROM is far too slow for ~150 files).
  (cd "$GFL_ROMS" 2>/dev/null && find . -type f -iname '*.rom' -printf '%P\t%s\n' | sort) |
    jq -cRn '{ok:true, roms:[inputs | select(length>0) | split("\t")
              | {file:.[0], method:(.[0]|split("/")[0]|ascii_downcase), size:(.[1]|tonumber)}]}'
}

cmd_adapters() { # amd|nvidia
  need vendor "${1:-}"
  local raw="" idx="[]"
  case "$1" in
    amd)    amd_present || fail no_tool "amdvbflash is not available on this USB"
            raw="$(amd_list || true)"
            idx="$(awk '/^[[:space:]]*[0-9]+[[:space:]]+[0-9A-Fa-f]{2}[[:space:]]/{print $1}' <<<"$raw" | jq -Rsc 'split("\n")|map(select(.!=""))|map(tonumber)')" ;;
    nvidia) nv_present || fail no_tool "nvflash is not available on this USB"
            raw="$(nv_list || true)"
            idx="$(grep -oE '^<[0-9]+>' <<<"$raw" | tr -d '<>' | jq -Rsc 'split("\n")|map(select(.!=""))|map(tonumber)')" ;;
    *)      fail usage "vendor must be amd or nvidia" 64 ;;
  esac
  emit --arg raw "$raw" --argjson i "$idx" '{ok:true, raw:$raw, indices:$i}'
}

cmd_backup_gpu() { # amd|nvidia index
  need vendor "${1:-}"; need index "${2:-}"
  allow_gpu_backup || refuse gated "graphics firmware backups are offered on supported iMacs and Mac Pro 4,1/5,1 (enable Expert mode to override)"
  local out
  case "$1" in
    amd)    out="$(amd_backup "$2")" || fail backup_failed "reading the current vBIOS failed — see the log" ;;
    nvidia) out="$(nv_backup "$2")"  || fail backup_failed "reading the current vBIOS failed — see the log" ;;
    *)      fail usage "vendor must be amd or nvidia" 64 ;;
  esac
  emit --argjson f "$(file_json "$out")" '{ok:true, backup:$f}'
}

# Where graphics firmware is worth sending. GopForge Live never uploads anything itself.
GFL_SUBMIT_DESTINATIONS='[
 {"name":"MacRumors — 2011 iMac Graphics Card Upgrade",
  "url":"https://forums.macrumors.com/threads/2011-imac-graphics-card-upgrade.1596614/",
  "how":"Where the IMAC-EFI-BOOT-SCREEN maintainer builds GOP/EnableGop firmware for new iMac cards. Post the .rom with README.txt and ask for support.",
  "for":"imac"},
 {"name":"TechPowerUp VGA BIOS Collection",
  "url":"https://www.techpowerup.com/vgabios/",
  "how":"The public archive of graphics-card firmware. Uploads go through GPU-Z on Windows, or the “VGA Bios collection – Bios uploading” forum thread: https://www.techpowerup.com/forums/threads/vga-bios-collection-bios-uploading.184704/",
  "for":"any"}
]'

# Package a graphics-firmware backup for sharing: its own folder on the USB with the
# .rom and a README describing the Mac and card (no serial numbers).
cmd_gpu_submission() { # amd|nvidia index backup
  need vendor "${1:-}"; need index "${2:-}"; need backup "${3:-}"
  local vendor="$1" idx="$2" b="$3"
  allow_gpu_backup || refuse gated "not offered on this machine"
  in_workdir "$b" || fail bad_file "not a file on this USB: $b"
  case "$b" in */video/Backups/*.rom) : ;; *) fail bad_file "not a graphics firmware backup: $(basename "$b")" ;; esac
  detect_gpus >/dev/null 2>&1 || true
  GFL_MODEL_KEY="${GFL_MAC_MODEL:-}"; model_profile
  local vid; case "$vendor" in amd) vid=1002;; nvidia) vid=10de;; *) fail usage "vendor must be amd or nvidia" 64;; esac
  local i gpu_lines="" first=""
  for i in "${!GFL_GPU_BDF[@]}"; do
    [ "${GFL_GPU_VENDOR[$i]}" = "$vid" ] || continue
    gpu_lines+="  ${GFL_GPU_BDF[$i]}  ${GFL_GPU_VENDOR[$i]}:${GFL_GPU_DEVICE[$i]}  subsystem ${GFL_GPU_SUBSYS[$i]}  ${GFL_GPU_NAME[$i]}"$'\n'
    [ -n "$first" ] || first="${GFL_GPU_DEVICE[$i]}-${GFL_GPU_SUBSYS[$i]//:/}"
  done
  local romfacts; romfacts="$(python3 - "$b" <<'PY'
import json, re, struct, sys
d = open(sys.argv[1], "rb").read()
o = {"size": len(d)}
if d[:2] == b"\x55\xaa" and len(d) > 0x1A:
    p = struct.unpack_from("<H", d, 0x18)[0]
    if d[p:p + 4] == b"PCIR":
        o["pci_id"] = "%04x:%04x" % struct.unpack_from("<HH", d, p + 4)
m = re.search(rb"113-[0-9A-Za-z_-]{5,}", d[:0x20000])
if m: o["part_number"] = m.group(0).decode()
m = re.search(rb"Version (\d+\.\d+\.\d+\.\d+)", d[:0x40000])
if m: o["nv_version"] = m.group(1).decode()
print(json.dumps(o))
PY
)" || romfacts='{}'
  local ts dir rom raw
  ts="$(date +%Y%m%d-%H%M%S)"
  dir="$GFL_WORKDIR/submissions/$ts-$vendor-${first:-unknown}"
  mkdir -p "$dir" || fail write_failed "couldn't create $dir"
  rom="$dir/$(basename "$b")"; cp "$b" "$rom"
  case "$vendor" in amd) raw="$(amd_list 2>/dev/null || true)";; nvidia) raw="$(nv_list 2>/dev/null || true)";; esac
  {
    echo "GopForge Live — graphics firmware submission"
    echo "Created $(date '+%Y-%m-%d %H:%M') with GopForge Live $GFL_VERSION (https://github.com/KurdtNervanna/GopForgeLive)"
    echo
    echo "Mac            : ${GFL_MAC_MODEL:-unknown}${GFL_MODEL_NOTE:+ — $GFL_MODEL_NOTE}"
    echo "Firmware file  : $(basename "$rom")"
    echo "  size         : $(file_size "$rom") bytes"
    echo "  sha256       : $(sha256_of "$rom")"
    jq -r '"  PCI ID in ROM: \(.pci_id // "—")\n  part number  : \(.part_number // .nv_version // "—")"' <<<"$romfacts"
    echo "Adapter        : #$idx ($vendor)"
    echo
    echo "Graphics cards in this Mac (lspci):"
    printf '%s' "${gpu_lines:-  (none matched)}"
    echo
    echo "Flasher's adapter list:"
    sed 's/^/  /' <<<"$raw"
    echo
    echo "Where to send it:"
    jq -r --arg c "${GFL_MACHINE_CLASS:-}" \
      '.[] | select(.for == "any" or $c != "cmp-bootrom") | "  • \(.name)\n    \(.url)\n    \(.how)\n"' <<<"$GFL_SUBMIT_DESTINATIONS"
    echo "No serial numbers are included in this folder."
  } >"$dir/README.txt"
  sync 2>/dev/null || true
  _log API "gpu-submission $vendor adapter=$idx -> $dir"
  emit --arg d "$dir" --argjson rom "$(file_json "$rom")" --arg readme "$dir/README.txt" \
       --argjson facts "$romfacts" --argjson dest "$GFL_SUBMIT_DESTINATIONS" \
       '{ok:true, folder:$d, rom:$rom, readme:$readme, facts:$facts, destinations:$dest}'
}

rom_method_for_file() { # relfile -> method from the matrix (first match)
  jq -r --arg f "$1" '[.cards[].roms[] | select(.file==$f) | .method][0] // empty' "$GFL_MATRIX" 2>/dev/null
}

cmd_flash_gpu() { # amd|nvidia index romfile backup [model_key]
  need vendor "${1:-}"; need index "${2:-}"; need rom "${3:-}"; need backup "${4:-}"
  local vendor="$1" idx="$2" romrel="$3" backup="$4"
  allow_gpu || refuse gated "GPU vBIOS flashing is not offered on this machine (enable Expert mode to override)"
  [ "${GFL_CONFIRM:-}" = "FLASH" ] || refuse unconfirmed "type FLASH to confirm"
  in_workdir "$backup" || refuse no_backup "a verified backup of this card on the USB is required first"
  [ "$(file_size "$backup")" -gt 0 ] || refuse no_backup "the backup file is empty"
  case "$vendor:$(basename "$backup")" in
    amd:amd-adapter"$idx"-*|nvidia:nvidia-idx"$idx"-*) : ;;
    *) refuse backup_mismatch "that backup was not taken from $vendor adapter $idx" ;;
  esac
  local rom; rom="$(resolve_rom "$romrel" || true)"
  [ -n "$rom" ] || fail no_rom "ROM not found in the library: $romrel"
  GFL_MODEL_KEY="${5:-${GFL_MAC_MODEL:-}}"; model_profile
  local m; m="$(rom_method_for_file "$romrel")"
  if [ -n "$m" ]; then
    case ",$GFL_FORBID," in *",$m,"*)
      truthy "$GFL_EXPERT" || refuse forbidden "${m^^} firmware is known not to work on $GFL_MODEL_KEY" ;;
    esac
  fi
  _log API "flash-gpu $vendor adapter=$idx rom=$romrel backup=$backup model=$GFL_MODEL_KEY expert=$GFL_EXPERT"
  local rc=0
  case "$vendor" in
    amd)    amd_flash "$idx" "$rom" no || rc=$? ;;
    nvidia) nv_flash "$idx" "$rom"     || rc=$? ;;
    *)      fail usage "vendor must be amd or nvidia" 64 ;;
  esac
  [ $rc -eq 0 ] || fail flash_failed "the flasher reported an error (exit $rc) — your backup is safe on the USB"
  emit --arg r "$romrel" --arg b "$backup" '{ok:true, flashed:$r, backup:$b}'
}

bootrom_facts() { # file -> JSON facts
  local f="$1" size n_anchor n_eg fvh=false
  size="$(file_size "$f")"; n_anchor="$(bytes_count "$f" "$ANCHOR_HEX")"; n_eg="$(bytes_count "$f" "$EG_HEX")"
  has_fvh "$f" && fvh=true
  emit --argjson s "$size" --argjson a "$n_anchor" --argjson e "$n_eg" --argjson fvh "$fvh" \
       --argjson four "$FOUR_MIB" \
       '{size:$s, is_4mib:($s==$four), firmware_volume:$fvh, cmp_fingerprint:($a>0),
         enablegop_count:$e, enablegop_present:($e>0), duplicate_enablegop:($e>1)}'
}

cmd_dump_bootrom() {
  allow_bootrom || refuse gated "BootROM work is only offered on Mac Pro 4,1/5,1 (enable Expert mode to override)"
  command -v flashrom >/dev/null 2>&1 || fail no_tool "flashrom is not available"
  local out; out="$(bootrom_dump)" || fail dump_failed "reading the BootROM failed — see the log"
  emit --argjson f "$(file_json "$out")" --argjson facts "$(bootrom_facts "$out")" \
       --argjson prot "$(protection_json "$out")" \
       '{ok:true, dump:$f, facts:$facts, protection:$prot}'
}

# Write protection as seen by the last flashrom read, judged against <rom>'s DXE volume.
protection_json() { # rom
  local blk="" blocks=false locked=false all
  if blk="$(bootrom_write_blocked "$1")"; then blocks=true; fi
  grep -qi 'SPI Configuration is locked down' "$GFL_FLASHROM_REPORT" 2>/dev/null && locked=true
  all="$(bootrom_wp_ranges | while read -r a z; do printf '0x%06X-0x%06X\n' "$a" "$z"; done)"
  emit --argjson b "$blocks" --argjson l "$locked" --arg r "$all" --arg blk "$blk" \
       --arg help "$GFL_FLASH_MODE_HELP" \
       '{blocks_patch:$b, config_locked:$l, protected:($r|split("\n")|map(select(length>0))),
         blocking:($blk|split("\n")|map(select(length>0))), help:$help}'
}

refuse_if_protected() { # rom [whole]
  local blk
  if blk="$(bootrom_write_blocked "$@")"; then
    refuse write_protected "the Boot ROM is write-protected in this session ($(tr '\n' ' ' <<<"$blk")read-only), so nothing was written. $GFL_FLASH_MODE_HELP"
  fi
}

cmd_check_bootrom() { # dump
  need dump "${1:-}"
  in_workdir "$1" || fail bad_file "not a file on this USB: $1"
  local txt=""
  [ -f "$GFL_GOPFORGE" ] && txt="$(bash "$GFL_GOPFORGE" --check "$1" 2>&1 | sed -E 's/\x1B\[[0-9;]*[A-Za-z]//g' || true)"
  emit --argjson facts "$(bootrom_facts "$1")" --arg t "$txt" '{ok:true, facts:$facts, report:$t}'
}

cmd_inject_bootrom() { # dump standard|direct
  need dump "${1:-}"; need variant "${2:-}"
  local dump="$1" variant="$2"
  allow_bootrom || refuse gated "BootROM work is only offered on Mac Pro 4,1/5,1"
  in_workdir "$dump" || fail bad_file "not a file on this USB: $dump"
  case "$variant" in standard|direct) : ;; *) fail usage "variant must be standard or direct" 64 ;; esac
  local facts; facts="$(bootrom_facts "$dump")"
  if ! truthy "$GFL_EXPERT"; then
    jq -e '.is_4mib' <<<"$facts" >/dev/null || refuse not_cmp "this dump is not 4 MiB — not a Mac Pro 4,1/5,1 BootROM"
    jq -e '.cmp_fingerprint' <<<"$facts" >/dev/null || refuse not_cmp "Mac Pro 4,1/5,1 fingerprint not found in this dump"
  fi
  jq -e '.enablegop_present|not' <<<"$facts" >/dev/null || refuse already_patched "EnableGop is already in this BootROM — inject only into a clean dump"
  local inj; inj="$(injector_state)"
  case "$inj" in
    ok) local out; out="$(bootrom_inject "$dump" "$variant")" || fail inject_failed "GopForge could not patch the dump — see the log" ;;
    mock)
      local out="${dump%.rom}-enablegop.rom" ffs="$GFL_GOPFORGE_TOOLS/EnableGop.ffs"
      [ "$variant" = direct ] && ffs="$GFL_GOPFORGE_TOOLS/EnableGopDirect.ffs"
      info "MOCK: inserting $(basename "$ffs") into free space…"; sleep 2
      perl -e 'my($i,$o,$f)=@ARGV; local $/; open(my $a,"<:raw",$i) or die; my $d=<$a>;
               open(my $b,"<:raw",$f) or die; my $e=<$b>; my $pad="\xFF" x (length($e)+64);
               my $p=index($d,$pad,0x150000); die "no space" if $p<0; $p=($p+7)&~7;
               substr($d,$p,length($e))=$e; open(my $c,">:raw",$o) or die; print $c $d' \
           "$dump" "$out" "$ffs" || fail inject_failed "mock inject failed"
      ok "MOCK: patched image written" ;;
    macos-only) refuse injector_unavailable "This USB only has the macOS DXEInject, which cannot run here. Rebuild the USB with tools/dxeinject-linux/build.sh." ;;
    broken) refuse injector_unavailable "The Linux EnableGop injector on this USB failed to start — see the log." ;;
    *) refuse injector_unavailable "The EnableGop injector (DXEInject) is missing on this USB." ;;
  esac
  local after; after="$(bootrom_facts "$out")"
  jq -e --argjson b "$facts" '.size==$b.size and .enablegop_count==1 and .cmp_fingerprint==$b.cmp_fingerprint' <<<"$after" >/dev/null \
    || { rm -f "$out"; fail validate_failed "the patched image failed validation — it will not be offered for flashing"; }
  bootrom_changes_confined "$dump" "$out" >/dev/null \
    || { rm -f "$out"; fail validate_failed "the patched image changed bytes outside the DXE volume — discarded"; }
  emit --argjson f "$(file_json "$out")" --argjson facts "$after" --arg v "$variant" \
       '{ok:true, patched:$f, facts:$facts, variant:$v}'
}

cmd_write_bootrom() { # patched original_dump
  need patched "${1:-}"; need dump "${2:-}"
  local p="$1" d="$2"
  allow_bootrom || refuse gated "BootROM flashing is only offered on Mac Pro 4,1/5,1"
  [ "${GFL_CONFIRM:-}" = "FLASH BOOTROM" ] || refuse unconfirmed "type FLASH BOOTROM to confirm"
  in_workdir "$d" || refuse no_backup "the original BootROM backup must be on this USB"
  in_workdir "$p" || refuse bad_file "the patched image must be on this USB"
  [ "$(readlink -f "$p")" != "$(readlink -f "$d")" ] || refuse bad_file "patched image and backup are the same file"
  local fp fd; fp="$(bootrom_facts "$p")"; fd="$(bootrom_facts "$d")"
  jq -e --argjson d "$fd" '.size==$d.size' <<<"$fp" >/dev/null || refuse size_mismatch "patched image and backup differ in size"
  if ! truthy "$GFL_EXPERT"; then
    jq -e '.is_4mib and .cmp_fingerprint and .enablegop_count==1' <<<"$fp" >/dev/null \
      || refuse invalid_image "the patched image failed the 4 MiB / fingerprint / single-EnableGop checks"
    bootrom_changes_confined "$d" "$p" >/dev/null \
      || refuse invalid_image "the patched image differs from the backup outside the DXE volume (NVRAM / boot block) — refusing to write it"
  fi
  _log API "write-bootrom patched=$p backup=$d expert=$GFL_EXPERT"
  local rc=0; bootrom_chip_matches "$d" || rc=$?
  [ "$rc" -le 1 ] && refuse_if_protected "$p"       # the read above refreshed the report
  case "$rc" in
    0) : ;;
    1) refuse stale_backup "the Boot ROM has changed since this backup was taken (the firmware writes NVRAM), so the patched image is out of date. Nothing was written — back up again and re-patch." ;;
    *) fail read_failed "re-reading the Boot ROM before writing failed — nothing was written; see the log" ;;
  esac
  bootrom_write "$p" || fail write_failed "flashrom reported a write error — do NOT power off; see Recovery"
  emit --arg p "$p" --arg d "$d" '{ok:true, written:$p, backup:$d}'
}

# Put an original BootROM backup back. Normally only when the chip is this backup
# plus changes inside the DXE volume (i.e. this Mac, patched since); otherwise the
# backup is stale or from another Mac and only Expert Mode may write it.
cmd_restore_bootrom() { # backup
  need backup "${1:-}"
  local b="$1"
  allow_bootrom || refuse gated "BootROM work is only offered on Mac Pro 4,1/5,1"
  [ "${GFL_CONFIRM:-}" = "RESTORE BOOTROM" ] || refuse unconfirmed "type RESTORE BOOTROM to confirm"
  in_workdir "$b" || refuse no_backup "the backup must be on this USB"
  case "$b" in */firmware/Backups/*.rom) : ;; *) refuse bad_file "not a Boot ROM backup: $(basename "$b")" ;; esac
  case "$(basename "$b")" in *-enablegop.rom) refuse bad_file "that is a patched image, not an original backup" ;; esac
  local fb; fb="$(bootrom_facts "$b")"
  if ! truthy "$GFL_EXPERT"; then
    jq -e '.is_4mib and .cmp_fingerprint' <<<"$fb" >/dev/null \
      || refuse invalid_image "this backup is not a complete Mac Pro 4,1/5,1 Boot ROM"
  fi
  local cur; cur="$(bootrom_read_tmp)" || fail read_failed "reading the Boot ROM failed — nothing was written; see the log"
  if cmp -s "$cur" "$b"; then
    rm -f "$cur"; ok "the Boot ROM already matches this backup — nothing to do"
    emit --arg b "$b" '{ok:true, restored:$b, unchanged:true}'; return
  fi
  local scope=""
  if ! bootrom_changes_confined "$b" "$cur" >/dev/null; then
    rm -f "$cur"
    truthy "$GFL_EXPERT" || refuse not_this_state "the chip differs from this backup outside the DXE volume (NVRAM / serial / boot block) — it is older than the chip's current state or from another Mac. Expert Mode can override."
    warn "Expert Mode: restoring a backup that differs outside the DXE volume"
    scope=whole
  fi
  rm -f "$cur"
  refuse_if_protected "$b" $scope
  _log API "restore-bootrom backup=$b expert=$GFL_EXPERT"
  bootrom_write "$b" || fail write_failed "flashrom reported a write error — do NOT power off; see Recovery"
  emit --arg b "$b" '{ok:true, restored:$b, unchanged:false}'
}

# --- 144.0.0.0.0 rebuild / 4,1 -> 5,1 crossflash ------------------------------------
cmd_templates() {
  local t="" ok=false
  t="$(template_find)" && ok=true
  emit --argjson ok "$ok" --arg p "$t" --arg dir "$GFL_TEMPLATE_DIR" --arg url "$GFL_TEMPLATE_URL" \
       --arg zs "$GFL_TEMPLATE_ZIP_SHA" --arg bs "$GFL_TEMPLATE_BIN_SHA" \
       '{ok:true, found:$ok, path:$p, dir:$dir, url:$url, zip_sha256:$zs, bin_sha256:$bs}'
}

cmd_rom_identity() { # rom
  need rom "${1:-}"
  in_workdir "$1" || fail bad_file "not a file on this USB: $1"
  local j; j="$(python3 "$GFL_REBUILD_PY" identity "$1")" || fail bad_file "could not read $(basename "$1")"
  printf '%s\n' "$j"
}

cmd_rebuild_bootrom() { # dump none|standard|direct
  need dump "${1:-}"; need variant "${2:-}"
  local dump="$1" variant="$2" rep out rc=0
  allow_bootrom || refuse gated "BootROM work is only offered on Mac Pro 4,1/5,1"
  in_workdir "$dump" || fail bad_file "not a file on this USB: $dump"
  case "$(basename "$dump")" in *-enablegop.rom|*-144*.rom) refuse bad_file "rebuild from an original backup, not from a patched or rebuilt image" ;; esac
  case "$variant" in none|standard|direct) : ;; *) fail usage "variant must be none, standard or direct" 64 ;; esac
  template_find >/dev/null || refuse no_template "No 144.0.0.0.0 template on this USB. Copy templates.zip from the MacRumors guide into gopforge-live/templates/."
  rep="$(mktemp)"
  out="$(GFL_REBUILD_REPORT="$rep" bootrom_rebuild "$dump")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    local e; e="$(jq -r '.error // empty' "$rep" 2>/dev/null)"; rm -f "$rep"
    case "$rc" in 4|3) refuse rebuild_refused "${e:-the rebuild was refused — see the log}" ;; *) fail rebuild_failed "${e:-the rebuild failed — see the log}" ;; esac
  fi
  local report; report="$(jq -c 'del(.ok)' "$rep")"; rm -f "$rep"
  if [ "$variant" != none ]; then
    [ "$(injector_state)" = ok ] || [ "$(injector_state)" = mock ] || refuse injector_unavailable "The Linux EnableGop injector isn't available on this USB."
    local eg; eg="$(bootrom_inject "$out" "$variant")" || fail inject_failed "adding EnableGop to the rebuilt image failed — see the log"
    jq -e '.enablegop_count==1' <<<"$(bootrom_facts "$eg")" >/dev/null || fail validate_failed "the rebuilt image with EnableGop failed validation"
    out="$eg"
  fi
  _log API "rebuild-bootrom dump=$dump variant=$variant -> $out"
  emit --argjson f "$(file_json "$out")" --argjson r "$report" --arg v "$variant" \
       --argjson facts "$(bootrom_facts "$out")" \
       '{ok:true, image:$f, report:$r, variant:$v, facts:$facts, crossflash:$r.crossflash}'
}

cmd_write_rebuilt() { # image original_dump
  need image "${1:-}"; need dump "${2:-}"
  local img="$1" d="$2"
  allow_bootrom || refuse gated "BootROM flashing is only offered on Mac Pro 4,1/5,1"
  [ "${GFL_CONFIRM:-}" = "REBUILD BOOTROM" ] || refuse unconfirmed "type REBUILD BOOTROM to confirm"
  in_workdir "$d" || refuse no_backup "the original Boot ROM backup must be on this USB"
  in_workdir "$img" || refuse bad_file "the rebuilt image must be on this USB"
  [ "$(readlink -f "$img")" != "$(readlink -f "$d")" ] || refuse bad_file "image and backup are the same file"
  template_find >/dev/null || refuse no_template "the 144.0.0.0.0 template is no longer on this USB"
  bootrom_is_rebuild_of "$img" "$d" \
    || refuse not_rebuild "this image is not the verified rebuild of $(basename "$d") — rebuild it again"
  jq -e '.is_4mib and .enablegop_count<=1' <<<"$(bootrom_facts "$img")" >/dev/null \
    || refuse invalid_image "the rebuilt image failed the 4 MiB / single-EnableGop checks"
  local donor; donor="$(python3 "$GFL_REBUILD_PY" identity "$d" | jq -r '.model // ""')"
  if [ "$donor" = MP41 ] && ! truthy "$GFL_EXPERT"; then
    refuse crossflash_unverified "Crossflashing a Mac Pro 4,1 to 5,1 firmware hasn't been verified on real hardware with GopForge Live yet. Turn on Expert Mode to go ahead — and have a CH341A programmer and your backup ready."
  fi
  _log API "write-rebuilt image=$img backup=$d donor=$donor expert=$GFL_EXPERT"
  local rc=0; bootrom_chip_matches "$d" || rc=$?
  [ "$rc" -le 1 ] && refuse_if_protected "$img" whole     # the whole chip is rewritten, boot block included
  case "$rc" in
    0) : ;;
    1) refuse stale_backup "the Boot ROM has changed since this backup was taken, so the rebuilt image is out of date. Nothing was written — back up again and rebuild." ;;
    *) fail read_failed "re-reading the Boot ROM before writing failed — nothing was written; see the log" ;;
  esac
  bootrom_write "$img" || fail write_failed "flashrom reported a write error — do NOT power off; see Recovery"
  emit --arg i "$img" --arg d "$d" --arg m "$donor" '{ok:true, written:$i, backup:$d, crossflash:($m=="MP41")}'
}

# Flash a graphics-firmware backup back onto the adapter it came from.
cmd_restore_gpu() { # amd|nvidia index backup
  need vendor "${1:-}"; need index "${2:-}"; need backup "${3:-}"
  local vendor="$1" idx="$2" b="$3"
  allow_gpu || refuse gated "GPU vBIOS work is not offered on this machine (enable Expert mode to override)"
  [ "${GFL_CONFIRM:-}" = "RESTORE" ] || refuse unconfirmed "type RESTORE to confirm"
  in_workdir "$b" || refuse no_backup "the backup must be on this USB"
  [ "$(file_size "$b")" -gt 0 ] || refuse bad_file "the backup file is empty"
  case "$vendor:$b" in
    amd:*/video/Backups/amd-adapter"$idx"-*.rom|nvidia:*/video/Backups/nvidia-idx"$idx"-*.rom) : ;;
    *) refuse backup_mismatch "that backup was not taken from $vendor adapter $idx" ;;
  esac
  _log API "restore-gpu $vendor adapter=$idx backup=$b"
  local rc=0
  case "$vendor" in
    amd)    amd_flash "$idx" "$b" no || rc=$? ;;
    nvidia) nv_flash "$idx" "$b"     || rc=$? ;;
    *)      fail usage "vendor must be amd or nvidia" 64 ;;
  esac
  [ $rc -eq 0 ] || fail flash_failed "the flasher reported an error (exit $rc) — the backup is still on the USB"
  emit --arg b "$b" --arg v "$vendor" --arg i "$idx" '{ok:true, restored:$b, vendor:$v, index:($i|tonumber)}'
}

cmd_backups() {
  local rows="[]" f kind
  for f in "$GFL_WORKDIR"/firmware/Backups/*.rom "$GFL_WORKDIR"/video/Backups/*.rom; do
    [ -f "$f" ] || continue
    case "$f" in */firmware/*) kind=bootrom;; *) kind=vbios;; esac
    case "$(basename "$f")" in *-enablegop.rom) kind=patched;; esac
    rows="$(jq -c --argjson fj "$(file_json "$f")" --arg k "$kind" \
      --arg t "$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null || true)" \
      '. + [$fj + {kind:$k, modified:$t}]' <<<"$rows")"
  done
  emit --argjson r "$rows" --arg wd "$GFL_WORKDIR" --arg med "${GFL_MEDIUM:-}" \
       '{ok:true, workdir:$wd, on_usb:($med!=""), files:($r|sort_by(.modified)|reverse)}'
}

cmd_log() { # [lines]
  local n="${1:-400}"
  emit --arg t "$(tail -n "$n" "$GFL_LOG" 2>/dev/null | sed -E 's/\x1B\[[0-9;]*[A-Za-z]//g' || true)" \
       --arg p "$GFL_LOG" '{ok:true, path:$p, text:$t}'
}

# --- dispatch --------------------------------------------------------------------
main() {
  local c="${1:-}"; shift || true
  case "$c" in
    ""|-h|--help) sed -n '2,20p' "$0"; exit 0 ;;
  esac
  setup
  case "$c" in
    status)          cmd_status ;;
    hardware)        cmd_hardware ;;
    gpus)            cmd_gpus ;;
    model)           cmd_model "$@" ;;
    plan)            cmd_plan "$@" ;;
    library)         cmd_library ;;
    adapters)        cmd_adapters "$@" ;;
    backup-gpu)      cmd_backup_gpu "$@" ;;
    flash-gpu)       cmd_flash_gpu "$@" ;;
    dump-bootrom)    cmd_dump_bootrom ;;
    check-bootrom)   cmd_check_bootrom "$@" ;;
    inject-bootrom)  cmd_inject_bootrom "$@" ;;
    write-bootrom)   cmd_write_bootrom "$@" ;;
    restore-bootrom) cmd_restore_bootrom "$@" ;;
    restore-gpu)     cmd_restore_gpu "$@" ;;
    hw-summary)      cmd_hw_summary ;;
    gpu-submission)  cmd_gpu_submission "$@" ;;
    templates)       cmd_templates ;;
    rom-identity)    cmd_rom_identity "$@" ;;
    rebuild-bootrom) cmd_rebuild_bootrom "$@" ;;
    write-rebuilt)   cmd_write_rebuilt "$@" ;;
    backups)         cmd_backups ;;
    snapshot)        gfl_log_session app; emit '{ok:true}' ;;
    log)             cmd_log "$@" ;;
    *)               fail usage "unknown command: $c" 64 ;;
  esac
}
main "$@"
