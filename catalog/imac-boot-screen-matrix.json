{
  "matrix_version": "0.2.0",
  "updated": "2026-09-23",
  "source": "https://github.com/Ausdauersportler/IMAC-EFI-BOOT-SCREEN (GPL-3.0)",
  "note": "ROM file paths are relative to the roms/ library populated by tools/fetch-roms.sh (packed .rom.zip entries are unzipped to .rom). Method ranking for recommendation: gop > eg2 > eg > uga, subject to model_rules constraints. Auto-flash is never blind: the wizard shows candidates and requires a backup + explicit confirm.",

  "methods": {
    "gop":  "Native UEFI GOP boot screen (best where supported).",
    "eg2":  "EnableGop2 injected vBIOS. Does NOT work on iMac10,1 A1312 (white screen).",
    "eg":   "EnableGop injected vBIOS. Works on ALL supported iMac models.",
    "eg91": "EnableGop91 variant required by iMac9,1 (LVDS). Named *EnableGop91* / *LVDS*.",
    "uga":  "Legacy UGA boot screen (oldest method).",
    "lvds": "LVDS-panel variant (iMac9,1 and iMac10,1 A1311). Polaris/GCN4 lack LVDS hardware."
  },

  "model_rules": {
    "iMac9,1":        {"panel": "lvds", "driver": "eg91", "note": "A1225 24\". Needs EnableGop91/LVDS ROMs. Best cards: M4000, M5100, W5170M, M6000. AVOID M6100/W6170M/W6150M (overheat under load)."},
    "iMac10,1-A1311": {"panel": "lvds", "driver": "eg",   "note": "21.5\" LVDS. Use LVDS ROMs. Polaris/GCN4 (WX/RX) have no LVDS: internal boot screen only via external DP + driver board."},
    "iMac10,1-A1312": {"panel": "edp",  "driver": "eg",   "forbid_methods": ["eg2"], "note": "27\" eDP. EG2 shows a white screen here — use EG or GOP only."},
    "iMac10,1":       {"panel": "unknown", "driver": "eg", "ambiguous": true, "note": "dmidecode cannot tell A1311 (21.5\" LVDS) from A1312 (27\" eDP). Confirm your panel: A1312/eDP must NOT use EG2."},
    "iMac11,1":       {"panel": "edp", "driver": "any", "note": "27\" eDP."},
    "iMac11,2":       {"panel": "edp", "driver": "any", "note": "21.5\" eDP."},
    "iMac11,3":       {"panel": "edp", "driver": "any", "note": "27\" eDP."},
    "iMac12,1":       {"panel": "edp", "driver": "any", "note": "21.5\" eDP."},
    "iMac12,2":       {"panel": "edp", "driver": "any", "note": "27\" eDP. Only card enabling BOTH external connectors + boot screen where noted."}
  },

