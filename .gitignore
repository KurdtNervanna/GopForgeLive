# Vendored upstream — populated by tools/fetch-*.sh, not committed.
# GopForge is MIT; IMAC-EFI-BOOT-SCREEN ROMs are GPL-3.0 — both stay out of this
# MIT repo and are fetched at build time.
/vendor/*
!/vendor/README.md
/vendor/*.ffs
/vendor/DXEInject*

# GPU vBIOS ROM library — GPL-3.0 blobs from IMAC-EFI-BOOT-SCREEN + generated
# index.json/UPSTREAM files; fetched by tools/fetch-roms.sh, never committed.
/roms/*
!/roms/.gitkeep

# Runtime / scratch
*.log
*.rom
*.bin
*-enablegop.rom
Backups/

# Base images downloaded by flash-usb/get-base-image.sh
/flash-usb/*.img
/flash-usb/*.iso
/flash-usb/*.zip
/flash-usb/*.img.*

# Fetched EnableGop tooling (gopforge --fetch lands here; third-party, do not commit)
/tools/DXEInject
/tools/EnableGop*.ffs
/tools/.dxeinject.sha256
